{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs", // or "esnext" if using ES Modules
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "csv-parse", "xlsx"]
  }
}